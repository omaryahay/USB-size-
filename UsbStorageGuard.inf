; USB Storage Guard Advanced — Author: Omar Yahya Silan
[Version]
Signature   = "$Windows NT$"
Class       = DiskDrive
ClassGuid   = {4D36E967-E325-11CE-BFC1-08002BE10318}
Provider    = %ProviderName%
CatalogFile = UsbStorageGuard.cat
DriverVer   = 11/06/2026,0.2.0.0

[DestinationDirs]
DefaultDestDir = 12

[Manufacturer]
%ProviderName% = USG, NTamd64

[USG.NTamd64]
%USG.DeviceDesc% = USG_Install, USBSTOR\Disk

[USG_Install.NT]
AddReg = USG_AddReg

[USG_Install.NT.Services]
AddService = UsbStorageGuard, 0x00000002, USG_Service

[USG_AddReg]
HKR,,UpperFilters,0x00010000,"UsbStorageGuard"

[USG_Service]
DisplayName    = %USG.ServiceDesc%
ServiceType    = 1
StartType      = 0
ErrorControl   = 1
ServiceBinary  = %12%\UsbStorageGuard.sys

[Strings]
ProviderName    = "Omar Yahya Silan"
USG.DeviceDesc  = "USB Storage Guard Advanced Filter"
USG.ServiceDesc = "USB Storage Guard Advanced"
